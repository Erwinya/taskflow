{
  "tasks": {
    "prep": {
      "action": "echo",
      "config": { "message": "prepare workspace" }
    },
    "wait": {
      "action": "sleep_ms",
      "depends_on": ["prep"],
      "config": { "ms": 5 }
    },
    "sum": {
      "action": "add",
      "depends_on": ["wait"],
      "config": { "a": 2, "b": 3 }
    },
    "done": {
      "action": "echo",
      "depends_on": ["sum"],
      "config": { "message": "pipeline complete" }
    }
  }
}
